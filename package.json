{
  "name": "yourchar",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "yourchar-acp": "./dist/src/acp/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk/index.d.ts",
      "import": "./dist/src/sdk/index.js"
    },
    "./acp": {
      "types": "./dist/src/acp/index.d.ts",
      "import": "./dist/src/acp/index.js"
    },
    "./runtime-events": {
      "types": "./dist/src/runtime-events/index.d.ts",
      "import": "./dist/src/runtime-events/index.js"
    }
  },
  "description": "Self-hosted AI characters with lasting memory, shared worlds, and tools for everyday life.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup:markitdown": "uv sync --project services/markitdown --frozen --python /usr/bin/python3",
    "dev": "npm run build && node --disable-warning=ExperimentalWarning dist/src/server.js",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "acp": "node --disable-warning=ExperimentalWarning dist/src/acp/stdio.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test dist/test/*.test.js",
    "test:memory-durability": "npm run build && node --disable-warning=ExperimentalWarning --test dist/test/memory-durability-r5.test.js",
    "test:browser": "npm run build && CLOAKBROWSER_AUTO_UPDATE=false LD_LIBRARY_PATH=${CLOAKBROWSER_LIB_DIR:-$HOME/.local/share/cloakbrowser-libs/usr/lib/x86_64-linux-gnu}:$LD_LIBRARY_PATH node --disable-warning=ExperimentalWarning test/browser.mjs",
    "eval:real-model": "npm run build && node --disable-warning=ExperimentalWarning scripts/eval-real-model.mjs",
    "eval:real-model:long": "npm run eval:real-model -- --long",
    "eval:lsp-navigation": "npm run build && node --disable-warning=ExperimentalWarning scripts/eval-lsp-navigation.mjs",
    "eval:memory-daily": "npm run build && node --disable-warning=ExperimentalWarning scripts/eval-memory-daily.mjs",
    "eval:background-classifiers": "npm run build && node --disable-warning=ExperimentalWarning scripts/eval-background-classifiers.mjs",
    "scan:sensitive": "node scripts/scan-sensitive.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup-state.mjs",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore-state.mjs",
    "migrate:state": "node --disable-warning=ExperimentalWarning scripts/migrate-state-directory.mjs migrate",
    "test:macos": "npm run build && node --disable-warning=ExperimentalWarning --test dist/test/macos-release-packaging.test.js",
    "package:macos": "bash scripts/build-macos-release.sh",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:real": "node scripts/release-gate.mjs --real"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.3",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "cloakbrowser": "^0.4.10",
    "playwright-core": "^1.61.1"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@fontsource/noto-emoji": "^5.3.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@twemoji/api": "^17.0.3",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.4.0",
    "linkedom": "^0.18.13",
    "lucide": "^1.24.0",
    "marked": "^18.0.6",
    "qrcode": "^1.5.4",
    "twemoji-svg": "^17.0.2",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "undici": "8.5.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
